. // Compute PLLFs: a bit slow
. use toydata, clear

. forvalues i=1/2 {
  2.         poisson d z if study==`i', exposure(py) 
  3.         local b`i'=_b[z]
  4.         local se`i'=_se[z]
  5.         pllf, profile(z) range(-3 2) nograph diff norm n(500) ///
>                 gen(beta`i' pll`i' norm`i'): ///
>                 poisson d z if study==`i', exposure(py) 
  6.         label var pll`i' "Study `i', exact PLLF"
  7.         label var norm`i' "Study `i', normal approx"
  8.         label var beta`i' "beta: log rate ratio for treatment"
  9. }

